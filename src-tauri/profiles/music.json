{
  "key": "music",
  "name": "Studio",
  "description": "Songs and the videos made for them: lyrics and style drafts judged on hook and craft, clips and shorts judged on the cut, shipped as clips, shorts and audio releases.",
  "config": {
    "work_kinds": [
      {
        "key": "song",
        "label": "Song"
      },
      {
        "key": "instrumental",
        "label": "Instrumental"
      },
      {
        "key": "video",
        "label": "Video",
        "axes": [
          {
            "key": "dynamics",
            "label": "Dynamics",
            "weight": 1.5,
            "scale": 10.0,
            "description": "Does the cut carry momentum, or does it sit on one shot?",
            "rubric": [
              {
                "at": 2,
                "label": "one shot held while the song happens"
              },
              {
                "at": 5,
                "label": "moves when the song moves, and nowhere else"
              },
              {
                "at": 8,
                "label": "you feel the drop before you hear it"
              }
            ]
          },
          {
            "key": "editing",
            "label": "Editing",
            "weight": 1.0,
            "scale": 10.0,
            "description": "Cuts on the beat, shots that answer each other.",
            "rubric": [
              {
                "at": 2,
                "label": "cuts land between the beats"
              },
              {
                "at": 5,
                "label": "clean cuts, no surprises"
              },
              {
                "at": 8,
                "label": "two shots argue and a third settles it"
              }
            ]
          },
          {
            "key": "fit",
            "label": "Fit to the track",
            "weight": 1.5,
            "scale": 10.0,
            "description": "Does the picture serve the song, or run beside it?",
            "rubric": [
              {
                "at": 2,
                "label": "a slideshow that happens to have music"
              },
              {
                "at": 5,
                "label": "illustrates the words line by line"
              },
              {
                "at": 8,
                "label": "shows what the song does not say"
              }
            ]
          },
          {
            "key": "picture",
            "label": "Picture",
            "weight": 1.0,
            "scale": 10.0,
            "description": "Composition, light and colour, frame by frame.",
            "rubric": [
              {
                "at": 2,
                "label": "you would not pause on any frame"
              },
              {
                "at": 5,
                "label": "every frame is fine and none is a still"
              },
              {
                "at": 8,
                "label": "there is a frame you would print"
              }
            ]
          },
          {
            "key": "story",
            "label": "Story",
            "weight": 1.0,
            "scale": 10.0,
            "description": "Is there an arc, or a mood held for three minutes?",
            "rubric": [
              {
                "at": 2,
                "label": "a mood, held"
              },
              {
                "at": 5,
                "label": "a situation with a change at the end"
              },
              {
                "at": 8,
                "label": "you could tell someone what happened"
              }
            ]
          }
        ],
