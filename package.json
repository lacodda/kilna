    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "dowel-ui": "^0.43.1",
    "i18next": "^27.1.1",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
