{
  "name": "kilna",
  "version": "0.109.0",
  "description": "A desktop workbench for content makers — from raw idea to shipped work.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm locales && tsc --noEmit && vite build",
