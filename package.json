    "format": "prettier --write .",
    "locales": "node tools/check-locales.mjs",
    "tokens": "node tools/check-tokens.mjs",
    "registry": "node tools/check-registry.mjs",
    "snippets": "dowel snippets --write",
    "tauri": "tauri",
    "test": "vitest run"
  },
